[Unit]
Description=Samvaad Sathi arq worker for long jobs (reports, question writing, Bulk ATS)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/apps/samvaad_sathi_backend/backend/backend

Environment="PATH=/home/ubuntu/apps/samvaad_sathi_backend/venv/bin"

# No EnvironmentFile needed - settings/base.py reads .env directly via
# python-decouple from the .env nearest the code (backend/backend/.env), same as the main service.
ExecStart=/home/ubuntu/apps/samvaad_sathi_backend/venv/bin/arq src.worker.main.SlowWorkerSettings

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
