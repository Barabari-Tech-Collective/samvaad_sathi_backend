ENVIRONMENT=DEV
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=8000
# 2 workers is a conservative starting point for a t3.small (2 vCPU / 2GB RAM) —
# this app loads heavy deps per worker process (PDF libs, OpenAI/boto3 SDKs), so
# the textbook "2x cores + 1" formula risks OOM on this instance size. Monitor
# memory after deploying and raise only if headroom allows; verify with a load
# test (see project scaling plan) rather than guessing higher.
BACKEND_SERVER_WORKERS=2

# AWS Aurora PostgreSQL Configuration
POSTGRES_SCHEMA=postgresql
POSTGRES_HOST=samvaad-sathi-instance-1.cjicoyuguai3.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
DB_TIMEOUT=30
# Total DB connections = BACKEND_SERVER_WORKERS x (DB_POOL_SIZE + DB_POOL_OVERFLOW).
# With 2 workers this is 2 x 20 = 40 connections. Before raising further, confirm
# your actual Postgres/Aurora max_connections with:
#   SELECT setting FROM pg_settings WHERE name = 'max_connections';
# and leave headroom for migrations, admin tools, and any other app connecting
# to the same database.
DB_POOL_SIZE=10
DB_MAX_POOL_CON=10
DB_POOL_OVERFLOW=10
IS_DB_ECHO_LOG=False
IS_DB_EXPIRE_ON_COMMIT=False
IS_DB_FORCE_ROLLBACK=False

IS_ALLOWED_CREDENTIALS=True

API_TOKEN=dev-api-token
AUTH_TOKEN=dev-auth-token
JWT_TOKEN_PREFIX=Bearer
JWT_SECRET_KEY=change_this_dev_secret
JWT_SUBJECT=access
JWT_ALGORITHM=HS256
JWT_MIN=1
JWT_HOUR=60
JWT_DAY=1

HASHING_ALGORITHM_LAYER_1=bcrypt
HASHING_ALGORITHM_LAYER_2=argon2
HASHING_SALT=change_this_salt
OPENAI_API_KEY= sk-xxx
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRTpX