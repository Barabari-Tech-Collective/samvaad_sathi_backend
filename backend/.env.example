ENVIRONMENT=DEV
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=8000
# 2 workers is a conservative starting point for a t3.small (2 vCPU / 2GB RAM) —
# this app loads heavy deps per worker process (PDF libs, OpenAI/boto3 SDKs), so
# the textbook "2x cores + 1" formula risks OOM on this instance size. Monitor
# memory after deploying and raise only if headroom allows; verify with a load
# test (see project scaling plan) rather than guessing higher.
BACKEND_SERVER_WORKERS=2

# AWS Aurora PostgreSQL Configuration
POSTGRES_SCHEMA=postgresql
POSTGRES_HOST=samvaad-sathi-instance-1.cjicoyuguai3.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
DB_TIMEOUT=30
# Total DB connections = BACKEND_SERVER_WORKERS x (DB_POOL_SIZE + DB_POOL_OVERFLOW).
# With 2 workers this is 2 x 20 = 40 connections. Before raising further, confirm
# your actual Postgres/Aurora max_connections with:
#   SELECT setting FROM pg_settings WHERE name = 'max_connections';
# and leave headroom for migrations, admin tools, and any other app connecting
# to the same database.
DB_POOL_SIZE=10
DB_MAX_POOL_CON=10
DB_POOL_OVERFLOW=10
IS_DB_ECHO_LOG=False
IS_DB_EXPIRE_ON_COMMIT=False
IS_DB_FORCE_ROLLBACK=False

IS_ALLOWED_CREDENTIALS=True

API_TOKEN=dev-api-token
AUTH_TOKEN=dev-auth-token
JWT_TOKEN_PREFIX=Bearer
JWT_SECRET_KEY=change_this_dev_secret
JWT_SUBJECT=access
JWT_ALGORITHM=HS256
JWT_MIN=1
JWT_HOUR=60
JWT_DAY=1

HASHING_ALGORITHM_LAYER_1=bcrypt
HASHING_ALGORITHM_LAYER_2=argon2
HASHING_SALT=change_this_salt
OPENAI_API_KEY= sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Which provider structured_output() (LLM reasoning calls only - question gen,
# scoring, resume analysis) actually uses. "openai" (default) or "deepseek".
# Whisper transcription and TTS are unaffected either way - see scaling plan
# Phase 7/8. Leave as "openai" until Phase 7's quality-check gate has passed.
LLM_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Which provider transcribe_audio_with_whisper() actually uses. "groq"
# (default) or "openai" (kept available as a fallback, not deleted). Groq
# hosts open-source Whisper via an OpenAI-compatible endpoint - see scaling
# plan Phase 8. STT_PROVIDER=openai still requires a real OPENAI_API_KEY,
# which stays needed regardless for the pronunciation TTS feature.
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRTpX

# Redis - self-hosted on the same EC2 instance (apt install redis-server),
# not a managed service, no extra bill. See project scaling plan Phase 4.
# Leave REDIS_PASSWORD empty only if Redis is bound to localhost and not
# reachable from outside the instance.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Per-user rate limits on endpoints that call metered third-party APIs.
RATE_LIMIT_TTS_PER_MINUTE=20
RATE_LIMIT_RESUME_ANALYSIS_PER_HOUR=10

# Per-IP throttles on the unauthenticated auth endpoints (brute-force /
# credential-stuffing protection). Enforced via Redis when available, with
# an in-process fallback so protection degrades rather than disappearing
# when Redis is down.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=20

# Minimum password length at registration. Existing shorter passwords can
# still be used to log in so pre-policy accounts aren't locked out.
MIN_PASSWORD_LENGTH=8

# Interactive API docs (/docs, /redoc, /openapi.json) are unauthenticated
# and expose the full endpoint inventory. Set to False on any
# internet-facing deployment; the routes then 404 instead of rendering.
EXPOSE_API_DOCS=True

# Comma-separated emails allowed to read the cross-student analytics /
# dashboard endpoints, in addition to any account with is_admin set in the
# database. Needed because is_admin defaults to false for existing rows and
# flipping it requires SQL access, which isn't always available to whoever
# configures the deployment. Leave empty to rely solely on the DB flag -
# empty grants nobody.
ADMIN_EMAILS=admin@samvaad-sathi.com

# How long cached TTS audio is kept (seconds). Default: 30 days.
TTS_CACHE_TTL_SECONDS=2592000